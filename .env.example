# Copy this file to .env and fill it in. Never commit .env (it is in .gitignore).

# Password for all demo users (sofie, lucas, marc, an, jan, po). Used when you run the generator.
DEMO_PASSWORD=

# Secret for signing login tokens, at least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MIRROR_JWT_SECRET=

# dev enables /api/docs. Use prod for anything public.
MIRROR_ENV=dev
MIRROR_CORS_ORIGINS=http://localhost:5173

# Optional AI tier. Without it, messages use templates. Option A: Gemini API key
GEMINI_API_KEY=
# Option B: Vertex AI on your Google Cloud project (run: gcloud auth application-default login)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1
GEMINI_MODEL=gemini-2.5-flash

# Optional voice channel (ElevenLabs). Voice id defaults to a stock multilingual voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional: show a euro estimate on the scale card. Check current Gemini pricing yourself.
MIRROR_LLM_EUR_PER_1K_TOKENS=
